TF_DATABASE_URL=sqlite:///.traceforge/control.db
TF_DATA_DIR=.traceforge
# Generate these with python scripts/bootstrap.py; never publish the generated .env
TF_DEVELOPER_TOKEN=
TF_REVIEWER_TOKEN=
TF_WEBHOOK_SECRET=
TF_APPROVAL_TTL_SECONDS=900
TF_LEASE_SECONDS=60

# Only reviewed fixture bytes are accepted in either mode. No arbitrary repository execution.
TF_EXECUTION_BACKEND=reviewed_subprocess
# docker_fixture requires a cached exact sha256 image ID + local rootless daemon.
TF_SANDBOX_IMAGE_ID=
# Set this to your actual rootless daemon socket on Linux/WSL:
# TF_SANDBOX_DOCKER_HOST=unix:///run/user/1000/docker.sock
